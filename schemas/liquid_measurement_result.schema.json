{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LiquidMeasurementResult",
  "description": "Written by PA to Analysis/<step_id>_result.json for LiquidMeasurement steps.",
  "type": "object",
  "required": ["step_id", "analysis_type", "command", "pipettes", "overall_status"],
  "properties": {
    "step_id": { "type": "string" },
    "analysis_type": { "type": "string", "const": "LiquidMeasurement" },
    "command": { "type": "object", "description": "Verbatim echo of the HTTP request payload." },
    "pipettes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "confidence"],
        "properties": {
          "index": { "type": "integer" },
          "total_volume_ul": { "type": ["number", "null"] },
          "slugs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "order": { "type": "integer" },
                "type": { "type": "string", "enum": ["liquid", "air"] },
                "start_px": { "type": "number" },
                "end_px": { "type": "number" },
                "volume_ul": { "type": "number" }
              }
            }
          },
          "bubbles": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "slug_order": { "type": "integer" },
                "location_px": { "type": "number" },
                "estimated_volume_ul": { "type": "number" }
              }
            }
          },
          "droplets": {
            "type": "array",
            "items": { "type": "object" }
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 100 },
          "comments": { "type": "string" }
        }
      }
    },
    "overall_status": {
      "type": "string",
      "enum": ["ok", "warning", "error", "low_confidence"]
    }
  }
}
